		<style>
			:root {
				--bg: #0a0a12;
				--fg: #f4f2ff;
				--muted: #a9a3c9;
				--card: rgba(255,255,255,0.05);
				--border: rgba(255,255,255,0.1);
				--accent1: #ff4ecb;
				--accent2: #7c5cff;
				--accent3: #4ee1ff;
			}

			* { box-sizing: border-box; }

			html, body {
				margin: 0;
				padding: 0;
				background: var(--bg);
				color: var(--fg);
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif;
				overflow-x: hidden;
			}

			.noise {
				position: fixed;
				inset: 0;
				pointer-events: none;
				z-index: 0;
				background:
					radial-gradient(circle at 20% 20%, rgba(255,78,203,0.18), transparent 40%),
					radial-gradient(circle at 80% 10%, rgba(124,92,255,0.22), transparent 40%),
					radial-gradient(circle at 50% 80%, rgba(78,225,255,0.15), transparent 40%);
			}

			nav {
				position: relative;
				z-index: 1;
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1.5rem 2rem;
				max-width: 1100px;
				margin: 0 auto;
			}

			.brand {
				font-weight: 800;
				font-size: 1.1rem;
			}
			.brand span {
				background: linear-gradient(90deg, var(--accent1), var(--accent2));
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.pill {
				font-size: 0.75rem;
				border: 1px solid var(--border);
				background: var(--card);
				padding: 0.35rem 0.8rem;
				border-radius: 999px;
				color: var(--muted);
			}

			.hero {
				position: relative;
				z-index: 1;
				max-width: 820px;
				margin: 3rem auto 4rem;
				padding: 0 1.5rem;
				text-align: center;
			}

			.badge {
				display: inline-block;
				font-size: 0.75rem;
				color: var(--muted);
				border: 1px solid var(--border);
				background: var(--card);
				padding: 0.5rem 1rem;
				border-radius: 999px;
				margin-bottom: 1.5rem;
			}

			h1 {
				font-size: clamp(2.2rem, 6vw, 3.6rem);
				line-height: 1.1;
				margin: 0 0 1.2rem;
				font-weight: 900;
				letter-spacing: -0.02em;
			}

			.grad {
				background: linear-gradient(90deg, var(--accent1), var(--accent2));
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}
			.grad2 {
				background: linear-gradient(90deg, var(--accent2), var(--accent3));
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.sub {
				color: var(--muted);
				font-size: 1.05rem;
				line-height: 1.7;
				max-width: 640px;
				margin: 0 auto 2rem;
			}

			.cta-row {
				display: flex;
				gap: 0.8rem;
				justify-content: center;
				flex-wrap: wrap;
				margin-bottom: 0.8rem;
			}

			.cta {
				display: inline-block;
				padding: 0.85rem 1.6rem;
				border-radius: 999px;
				font-weight: 700;
				text-decoration: none;
				font-size: 0.95rem;
				background: linear-gradient(90deg, var(--accent1), var(--accent2));
				color: white;
				box-shadow: 0 8px 30px rgba(124,92,255,0.35);
			}
			.cta.ghost {
				background: transparent;
				border: 1px solid var(--border);
				color: var(--fg);
				box-shadow: none;
			}

			.tiny {
				font-size: 0.8rem;
				color: var(--muted);
			}

			.marquee {
				position: relative;
				z-index: 1;
				overflow: hidden;
				border-top: 1px solid var(--border);
				border-bottom: 1px solid var(--border);
				background: rgba(255,255,255,0.02);
				padding: 0.9rem 0;
				white-space: nowrap;
			}
			.track {
				display: inline-flex;
				gap: 3rem;
				animation: scroll 18s linear infinite;
				font-weight: 700;
				font-size: 0.85rem;
				color: var(--muted);
				letter-spacing: 0.05em;
			}
			@keyframes scroll {
				from { transform: translateX(0); }
				to { transform: translateX(-50%); }
			}

			.features {
				position: relative;
				z-index: 1;
				max-width: 1100px;
				margin: 5rem auto;
				padding: 0 1.5rem;
			}
			.features h2 {
				text-align: center;
				font-size: clamp(1.6rem, 4vw, 2.2rem);
				margin-bottom: 2.5rem;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1.2rem;
			}
			.card {
				background: var(--card);
				border: 1px solid var(--border);
				border-radius: 16px;
				padding: 1.6rem;
				backdrop-filter: blur(10px);
			}
			.card .icon {
				font-size: 1.8rem;
				margin-bottom: 0.8rem;
			}
			.card h3 {
				margin: 0 0 0.5rem;
				font-size: 1.05rem;
			}
			.card p {
				color: var(--muted);
				font-size: 0.9rem;
				line-height: 1.6;
				margin: 0;
			}
			.card code {
				background: rgba(255,255,255,0.08);
				padding: 0.1rem 0.4rem;
				border-radius: 4px;
				font-size: 0.85em;
			}

			.stats {
				position: relative;
				z-index: 1;
				max-width: 1000px;
				margin: 5rem auto;
				padding: 0 1.5rem;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 1.5rem;
				text-align: center;
			}
			.stat .num {
				font-size: 2.6rem;
				font-weight: 900;
				background: linear-gradient(90deg, var(--accent1), var(--accent3));
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}
			.stat .label {
				color: var(--muted);
				font-size: 0.8rem;
				margin-top: 0.4rem;
			}

			.install {
				position: relative;
				z-index: 1;
				max-width: 700px;
				margin: 5rem auto;
				padding: 0 1.5rem;
				text-align: center;
			}
			.install h2 {
				font-size: clamp(1.6rem, 4vw, 2.2rem);
				margin-bottom: 1.5rem;
			}
			.install pre {
				text-align: left;
				background: #0e0e18;
				border: 1px solid var(--border);
				border-radius: 12px;
				padding: 1.2rem 1.4rem;
				overflow-x: auto;
				font-size: 0.85rem;
				line-height: 1.7;
				color: #baffc9;
			}

			footer {
				position: relative;
				z-index: 1;
				max-width: 700px;
				margin: 0 auto;
				padding: 2rem 1.5rem 4rem;
				text-align: center;
				color: var(--muted);
				font-size: 0.85rem;
				line-height: 1.7;
			}
		</style>
	</body>
</html>
